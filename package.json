{
  "name": "vinty-pos",
  "version": "1.0.0",
  "description": "Vinty Coffee & Space POS — Expo, React Native, TypeScript, local transactions, inventory and sales reports.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhaqx/veloce-landing-page.git"
  },
  "homepage": "https://veloce-landing-page.vercel.app",
  "engines": { "node": ">=20.19.4" },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "export:web": "node scripts/build-web.mjs",
    "preview": "node scripts/serve-web.mjs",
    "assets:generate": "node scripts/create-assets.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "test": "node --import tsx --test tests/pos.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-file-system": "~19.0.24",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "tsx": "^4.20.0",
    "sharp": "0.33.5",
    "typescript": "~5.9.2"
  }
}
